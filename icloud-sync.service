[Unit]
Description=Two-way sync between a local folder and iCloud Drive

[Service]
# Installed by install.sh. Settings are in ~/.config/icloud-sync/config
ExecStart=%h/.local/bin/icloud-sync --watch
Restart=on-failure
RestartSec=5min
# Exit code 2 means the first icloud-sync --resync hasn't been run; restarting won't help
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
